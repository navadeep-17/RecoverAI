# RecoverAI Environment Configuration Example

# Server & Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Web dashboard (development header identity for the deterministic demo tenant)
VITE_API_BASE_URL=http://localhost:3000
VITE_DEV_MERCHANT_ID=recoverai-demo-merchant
VITE_DEV_USER_ID=recoverai-demo-admin
VITE_DEV_USER_ROLE=MERCHANT_ADMIN

# Database (PostgreSQL)
DATABASE_URL=postgresql://recoverai:recoverai_secret@localhost:5432/recoverai?schema=public

# Worker / Job Queue (pg-boss via PostgreSQL)
PG_BOSS_SCHEMA=pgboss

# Authentication & Sessions
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
# Local development only. Production requires AUTH_MODE=trusted_headers.
AUTH_MODE=dev_headers
# AUTH_TRUST_SECRET=server_side_gateway_secret_at_least_32_characters_long

# AI Provider (Provider-neutral interface)
AI_PROVIDER=mock
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

# Razorpay Test Mode (Phase 7)
# RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_SECRET=placeholder_secret
# RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
# RAZORPAY_TEST_MERCHANT_ID=recoverai-demo-merchant

# Logging
LOG_LEVEL=info
