{
  "name": "recoverai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "RecoverAI: Policy-Governed Autonomous Revenue Recovery Agent",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "vitest run",
    "evaluate": "npm run evaluate --workspace=@recoverai/evaluation --",
    "runtime:proof": "tsx scripts/runtime-proof.ts",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "npm run --workspaces --if-present clean",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build:packages": "npm run --workspace=@recoverai/shared build && npm run --workspace=@recoverai/db build && npm run --workspace=@recoverai/core build && npm run --workspace=@recoverai/policy build && npm run --workspace=@recoverai/integrations build && npm run --workspace=@recoverai/evaluation build",
    "db:generate": "npm run --workspace=@recoverai/db db:generate",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:setup": "npm run db:generate && npm run db:migrate:deploy && npm run demo:seed",
    "razorpay:proof:setup": "tsx scripts/razorpay-proof.ts setup",
    "razorpay:proof:reset": "tsx scripts/razorpay-proof.ts reset",
    "razorpay:proof:verify": "tsx scripts/razorpay-proof.ts verify",
    "demo": "vitest run packages/db/tests/closed-loop.integration.test.ts apps/worker/tests/worker.integration.test.ts --reporter=verbose",
    "dev:api": "npm run dev --workspace=@recoverai/api",
    "dev:worker": "npm run dev --workspace=@recoverai/worker",
    "dev:web": "npm run dev --workspace=@recoverai/web",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.2",
    "prisma": "^5.16.1",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
